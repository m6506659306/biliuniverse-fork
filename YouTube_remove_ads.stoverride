name: YouTube去广告
desc: 移除YouTube视频、瀑布流、搜索和Shorts中的广告，移除底部上传和Shorts按钮，增加画中画及字幕翻译功能，支持后台播放。支持Premium订阅用户，不支持tvOS设备。
category: 去广告

http:
  force-http-engine:
    - youtubei.googleapis.com
    - "*.googlevideo.com"
  mitm:
    - "*.googlevideo.com"
    - youtubei.googleapis.com
  url-rewrite:
    - '^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&oad - reject'
  script:
    - name: youtube.response
      match: ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch)
      type: response
      require-body: true
      binary-mode: true
      argument: '{"blockUpload":false,"blockShorts":false,"captionLang":"off"}'

script-providers:
  youtube.response:
    url: https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.response.js
    interval: 86400

rules:
  - AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
  - AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT
