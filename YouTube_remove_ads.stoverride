name: YouTube 去广告 (Enhance)
desc: |-
  移除 YouTube / YouTube Music 播放、推荐流、搜索、Shorts 中的广告；可屏蔽上传、选段、Shorts 按钮；支持字幕翻译。
  覆写内容与 Maasea/sgmodule 的 YouTube.Enhance.sgmodule 逐项对齐：3 条脚本（1 response + 2 request）齐备，
  均要求完整响应体（max-size 放宽），MITM 域与上游模块一致。
category: 去广告

http:
  mitm:
    - "*.googlevideo.com"
    - youtubei.googleapis.com
  script:
    - name: youtube.response
      match: '^https://youtubei\.googleapis\.com/(youtubei/v1/(browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch|log_event|config))(\?(.*))?$'
      type: response
      require-body: true
      binary-mode: true
      max-size: 10485760
      argument: '{"captionLang":"off","blockUpload":true,"blockImmersive":true,"blockShorts":false,"debug":false}'
    - name: youtube.request
      match: '^https?://[\w-]+\.googlevideo\.com/initplayback.+&ack.*'
      type: request
      require-body: true
      binary-mode: true
      max-size: 10485760
    - name: youtube.request
      match: '^https://youtubei\.googleapis\.com/youtubei/v1/log_event'
      type: request
      require-body: true
      binary-mode: true
      max-size: 10485760

script-providers:
  youtube.response:
    url: https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.response.js
    interval: 86400
  youtube.request:
    url: https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.request.js
    interval: 86400
